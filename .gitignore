# 构建产物（见 docs/03 §5、docs/10 §1：产物不入库，由 CI 构建）
web/data/
web/*/*.html
web/*.html
!web/index.html
!web/*.template.html
!web/promo.html
# 第三方全量生态图：事实源在 vendor/dsh-plugin-mesh/（入库），web/mesh/ 是构建期拷出来的产物
web/mesh/

# 依赖与缓存
node_modules/
.pnpm-store/
*.log

# 本地抓页/临时目录（子代理或脚本留下的抓取缓存）
.probe/
.tmp/

# 编辑器与系统
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store

# SEO 产物（构建期生成，见 docs/10 §1）
web/sitemap.xml
web/robots.txt

# 构建清单（机器状态，不入库；见 docs/10 §1）
web/.pedia-manifest.json
